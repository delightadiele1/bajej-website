extends base

mixin service-list(text, info, active='')
    a(href="").service-links
        li.text-white.bg-dark.p-3.mb-3.light.service-list(class=`${active}`, data-bs-info=`${info}`)
            .row 
                .col-1.my-auto
                    i.fa.fa-check.text-primary.me-3
                .col-11
                    | #{text}

mixin headings(text)
    .service__item-toggle
        h2.fs-3.text-center.display-5(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") #{text}.
        .row 
            .col-5
                .line.border.border-1.rounded-pill.border-secondary.mt-2
            .col-2.text-center.p-0
                i.fa.fa-cog.text-primary.fs-3.spin-on-hover
            .col-5
                .line.border.border-1.rounded-pill.border-secondary.mt-2

mixin chooseUs(head, body) 
    p ✅ 
        b #{head}: 
        | #{body}

block content 

    //  Page Header Start 
    .container-fluid.about__page-header.page__header
        h1.display-5.text-primary.mb-3.about-text Our Services
            i.fa.fa-tools.fa-2x.text-primary.mb-4
        .d-inline-flex.text-primary.fade-out
            h6.m-0
                a.text-white(href="/") Home &gt;&gt;
                h6.text-white.m-0.px-3 /
            h6.text-primary.m-0 Services
    //  Page Header Start 
    .container.page-section.py-6
        .row.g-4
            .col-lg-5.service__links-container
                .animate-from-left
                    h1.display-5.mb-4.ps-2.py-2(style="border-left: 6px solid #f4d73c") Our 
                        span.text-primary Services
                    .p-3(style="background-color: #eeedecff;")
                        p.text-gray.fs-5
                            b Bajej Oil & Gas LTD 
                            | is highly specialized in key areas of the oil and gas industry, including but not limited to the following;
                        ul.list-unstyled
                            +service-list('Onshore Laying of Oil & Gas Pipeline, Pipeline Fabrication, Construction and Maintenance.', 'onshore__pipe-laying', 'active-service')
                            +service-list('Pipeline Leak Repairs using Clamps, including Split-tee and Split Sleeve.', 'pipeLine__leak-repairs')
                            +service-list('Valve Change out, installation and maintenance.', 'valve__change-out')
                            +service-list('Manifold Upgrade, modification and maintenance.', 'manifold__upgrade')
                            +service-list('Barrel assembly modification, Barrel Doors replacement and maintenance', 'barrel__assembly')
                            +service-list('Procurement of Oil & Gas Tools and Equipments.', 'procurement__tools-equipment')

                .animate-from-down.text-gray.mt-5.p-3.bg-light.d-none.d-lg-block
                    h1.display-5.fs-1 Why Choose Us?
                    +chooseUs('Certified Experts', 'Highly skilled and certified pipeline engineers and technicians')
                    +chooseUs('Safety First', 'Compliance with international HSE standards (ISO, OSHA, DPR regulations')
                    +chooseUs('Proven Track Record', 'Successful delivery of multiple onshore pipeline projects across Nigeria')
                    +chooseUs('Advanced Equipment', 'Modern tools and machinery for precision and efficiency')
                    +chooseUs('Sustainability Focus', 'Minimal environmental footprint in all our operations')


            .col-lg-7.mt-5.mt-lg-4#service-section
                //- Onshore laying of pipeline
                //- 
                //- 
                //-
                .onshore__pipe-laying.service-content
                    +headings('Onshore Laying of Oil & Gas Pipeline, Pipeline Fabrication, Construction and Maintenance')
                    .row.g-4.pt-4
                        h6.text-secondary.fs-4.mb-1(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") 
                            b Onshore Pipeline services
                        p.text-gray.fs-6 At 
                            b Bajej Oil & Gas LTD
                            | , we specialize in the onshore laying, fabrication, construction, and maintenance of oil and gas pipelines. With a commitment to safety, efficiency, and engineering excellence, we deliver end-to-end pipeline solutions that meet the highest industry standards.

                    h6.display-5.fs-5.mb-4(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Our Core Services include;
                    p.text-secondary.mb-5.fs-4 1. 
                        b   Pipeline Laying (Onshore)

                    .row.g-4
                        .col-sm-6
                            img.img-fluid.fade-in(src="/img/IMG-20250716-WA0049.jpg", alt="Pipe Laying Image")
                        .col-sm-6
                            img.img-fluid.fade-in(src="/img/IMG-20250716-WA0070.jpg", alt="Pipe Laying Image")

                    .text-gray.py-4
                        p We provide professional onshore pipeline laying services for crude oil, natural gas, refined products, and water injection lines. Our capabilities include:
                        ul
                            li Trenching and pipeline alignment
                            li Welding and joint coating
                            li Backfilling and hydrotesting
                            li Route optimization and terrain management
                            li Environmentally responsible practices
                        
                    p.text-secondary.mb-4.fs-4 2. 
                            b   Pipeline Fabrication

                    .row.g-4
                        .col-md-6.text-gray
                            p Our in-house or on-site fabrication services ensure that your pipeline components are precision-built to spec:
                            ul
                                li Pipe spooling
                                li Welding and non-destructive testing (NDT)
                                li Bending and coating
                                li Fabrication of manifolds, skids, and structural supports

                        .col-md-6 
                            img.img-fluid.fade-in(src="/img/IMG-20250716-WA0051.jpg", alt="Pipe Laying Image")

                //- Clamps leak repair
                //- 
                //- 
                //- 

                .pipeLine__leak-repairs.service-content.hide-content
                    +headings('Pipeline Leak Repairs using Clamps, including Split-tee and Split Sleeve')
                    .row.g-4.pt-4
                        img.img-fluid.fade-out(src="/img/IMG-20250716-WA0033.jpg", alt="Pipe Clamp Image")

                    .row.g-4.pt-4
                        h6.text-secondary.fs-4.mb-1(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Pipeline Leak Repairs
                        p.text-gray At 
                            b Bajej Oil & Gas LTD
                            | , we provide specialized pipeline leak repair services using industry-approved solutions such as repair clamps, split-tee fittings, and split sleeve enclosures. Our methods ensure safe, fast, and permanent repairs to both pressurized and depressurized onshore pipelines—without compromising pipeline integrity or safe.

                    h6.display-5.fs-5.mb-4(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Our Leak Repair Techniques;
                    p.text-secondary.mb-4.fs-4 1. 
                        b   🗜️ Repair Clamps

                    .row.g-4
                        .col-sm-6
                            p.text-gray 
                                b Bajej Oil & Gas 
                                | provides professional pipeline leak repair services utilizing engineered repair clamps for fast, safe, and reliable intervention on onshore pipelines. Our clamp-based solutions are ideal for immediate leak containment and long-term sealing across a variety of pipeline diameters and pressures.
                        .col-sm-6.animate-from-down
                            img.img-fluid(src="/img/IMG-20250726-WA0018.jpg", alt="Pipe Laying Image")

                    
                        .col-sm-6.text-gray
                            p 
                                b Applications include:
                            ul
                                li Corrosion pinholes
                                li Small cracks or fractures
                                li Gasket or weld failures
                                li Temporary or permanent repairs
                                
                        .col-sm-6.text-gray
                            p 
                                b Features:
                            ul
                                li Quick installation without shutdown (in many cases)
                                li Stainless steel or carbon steel construction
                                li High pressure and temperature ratings
                                li Available in custom sizes for various pipe diameters

                    p.text-secondary.mb-4.fs-4 2. 
                        b  🔩 Split Tee Repairs 

                    img.img-fluid.fade-in(src="/img/IMG-20250327-WA0015.jpg")

                    .row.g-4.text-gray.my-3
                        p 
                            b Bajej Oil & Gas 
                            | delivers Split-Tee-based pipeline repair services for critical leak containment and structural reinforcement on pressurized lines—especially where flow continuity is essential. Our team executes precision field deployment of Split-Tee fittings as part of controlled hot tapping, line stop, or permanent leak repair projects.
                        .col-sm-6
                            p 
                                b Use cases:

                            ul 
                                li Active pipelines where flow must be maintained
                                li Preparation for future line tapping or bypass
                                li Stronger reinforcement than basic clamps
                        .col-sm-6
                            p
                                b Benefits:

                            ul
                                li Maintains continuous production during repair
                                li Enables future valve or bypass installations
                                li Designed to meet ASME and API standards

                    p.text-secondary.mb-4.fs-4 2. 
                        b  ⚙️ Split Sleeves Leak Repair

                    .row.g-4.text-gray.my-3
                        .col-sm-6
                            p At 
                                b Bajej Oil & Gas 
                                | we offer split sleeve repair services as a dependable solution for restoring pipeline integrity in the face of corrosion damage, dents, or localized failures
                            ul
                                li External corrosion
                                li Mechanical damage
                                li Weld defects
                                li Minor ruptures
                        .col-sm-6
                            img.img-fluid.fade-in(src="/img/IMG-20240823-WA0011.jpg")
                //- 
                //- 
                //- 
                .valve__change-out.service-content.hide-content
                    +headings('Valve Change out, installation and maintenance.')
                    .row.g-4.pt-4
                        h6.text-secondary.fs-4.mb-1(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Valve Change out
                        p.text-gray
                            b Bajej Oil & Gas LTD 
                            | offers professional services in the installation, replacement, and maintenance of valves across a variety of oil and gas pipeline systems. Our experienced technicians and field engineers are equipped to handle everything from small-bore valve installations to critical valve change-outs on high-pressure lines.
                        
                        .row.g-4.text-gray.my-3
                            .col-sm-6
                                .row.g-4
                                    .col-12
                                         img.img-fluid.fade-in(src="/img/1000000444.jpg")
                                    .col-12
                                        p We support upstream, midstream, and downstream operators with reliable valve services that ensure safe operation, flow control efficiency, and regulatory compliance. Whether during shutdowns, facility upgrades, or emergency replacements, 
                                            b Bajej 
                                            | delivers with precision, speed, and a strong commitment to safety
                            .col-sm-6
                                img.img-fluid.img__height-sm.fade-in(src="/img/IMG-20250726-WA0009.jpg")
                //- 
                //- 
                //- 
                //- 
                .manifold__upgrade.service-content.hide-content
                    +headings('Manifold Upgrade, Maintenance & Modification')
                    
                    .row.g-4.pt-4
                        h6.text-secondary.fs-4.mb-1(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Manifold System Services
                        p.text-gray 
                            b Bajej Oil & Gas LTD 
                            | provides expert services in the inspection, upgrade, modification, and routine maintenance of manifold systems across oil and gas installations. We ensure your production manifolds, test manifolds, and injection manifolds remain fully functional, safe, and optimized for performance.

                    .row.g-4.align-items-center
                        .col-md-6
                            img.img-fluid.fade-in(src="/img/IMG-20250726-WA0021.jpg", alt="Manifold System Image")
                        .col-md-6.text-gray
                            p We handle all aspects of manifold servicing including component replacement, structural adjustments, and optimization for flow assurance and pressure balancing. Our services are tailored to extend asset lifespan and minimize production downtime.

                    .row.g-4.mt-4.align-items-center
                        .col-md-6.text-gray
                            p 
                                b Scope of Services:
                            ul
                                li Manifold system inspections and diagnostics
                                li Upgrades and reconfiguration of flow paths
                                li Valve and piping replacements within manifold units
                                li Welding, painting, and corrosion protection
                                li Pressure testing and commissioning

                        .col-md-6
                            img.img-fluid.fade-in(src="/img/IMG-20250726-WA0020.jpg", alt="Manifold Upgrade Work")

                    .row.g-4.mt-4.align-items-center
                        .col-md-6
                            img.img-fluid.fade-in(src="/img/IMG-20250726-WA0022.jpg", alt="Manifold Maintenance")
                        .col-md-6.text-gray
                            p Our technicians work with precision and efficiency in both greenfield and brownfield environments, ensuring that manifolds are safely modified and aligned with operational goals. 
                            p 
                                b Bajej Oil & Gas 
                                | remains a trusted partner for operators seeking high-integrity manifold support.

                //- 
                //- 
                //- 
                //- 
                .barrel__assembly.service-content.hide-content
                    +headings('Barrel Assembly Modification, Barrel Doors Replacement and Maintenance')

                    .row.g-4.pt-4
                        h6.text-secondary.fs-4.mb-1(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Barrel Services
                        p.text-gray
                            b Bajej Oil & Gas LTD 
                            | specializes in comprehensive barrel services for launcher and receiver systems, including barrel assembly modifications, barrel door replacements, and preventive maintenance. Our team ensures these critical pipeline components meet safety, operational, and integrity requirements.

                    h6.display-5.fs-5.mb-4(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Our Core Services;

                    p.text-secondary.mb-4.fs-4 1. 
                        b   Barrel Assembly Modification

                    .row.g-4
                        .col-md-6.text-gray
                            p We offer in-site and workshop-based modifications of launcher/receiver barrels to meet operational upgrades or code compliance. Our services include:
                            ul
                                li Extension or resizing of barrels
                                li Reinforcement and wall thickness upgrade
                                li Custom nozzle and branch connections
                                li Conversion for smart pigging capabilities
                        .col-md-6
                            img.img-fluid.fade-in(src="/img/IMG-20250716-WA0032.jpg", alt="Barrel Assembly Image")

                    p.text-secondary.mb-4.fs-4 2. 
                        b   Barrel Doors Replacement

                    .row.g-4
                        .col-md-6.text-gray
                            p Bajej provides safe removal and installation of quick-opening closures (QOCs) and barrel doors on launchers and receivers. Whether during facility upgrades or scheduled maintenance, we ensure:
                            ul
                                li Compliance with ASME/PED pressure vessel codes
                                li Proper sealing and locking mechanisms
                                li Testing and certification
                                li Minimal operational downtime
                        .col-md-6
                            img.img-fluid.fade-in(src="/img/IMG-20250716-WA0034.jpg", alt="Barrel Door Replacement Image")

                    p.text-secondary.mb-4.fs-4 3. 
                        b   Preventive Maintenance

                    .row.g-4
                        .col-md-6.text-gray
                            p To ensure safe operations and extend the lifespan of your pipeline barrel systems, Bajej offers tailored maintenance programs. Our technicians inspect, clean, and service:
                            ul
                                li Sealing systems and O-rings
                                li Locking mechanisms
                                li Pressure integrity checks
                                li External and internal corrosion checks
                        .col-md-6
                            img.img-fluid.fade-in(src="/img/IMG-20250716-WA0044.jpg", alt="Barrel Maintenance Image")

                //- 
                //- 
                //- 
                //- 

                .procurement__tools-equipment.service-content.hide-content
                    +headings('Procurement of Oil & Gas Tools and Equipment')
                    
                    .row.g-4.pt-4
                        h6.text-secondary.fs-4.mb-1(style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;") Reliable Oilfield Procurement Solutions
                        p.text-gray
                            b Bajej Oil & Gas LTD 
                            | offers end-to-end procurement services covering a broad spectrum of oilfield tools and equipment. Our partnerships with OEMs and certified distributors allow us to deliver quality, compliance, and cost-efficiency across every order.

                    .row.row-cols-1.row-cols-sm-2.row-cols-md-3.g-4.py-3.text-gray
                        .col
                            .card.border-0.shadow-sm.h-100
                                img.card-img-top(src="/img/IMG-20250726-WA0025.jpg", alt="Valves and Fittings")
                                .card-body
                                    h6.card-title.mb-1.fs-6.display-5 Valves & Fittings
                                    p.card-text Precision valves, elbows, reducers, tees, and pipe connectors for high-pressure systems.

                        .col
                            .card.border-0.shadow-sm.h-100
                                img.card-img-top(src="/img/IMG-20250726-WA0026.jpg", alt="Welding Tools")
                                .card-body
                                    h6.card-title.mb-1.fs-6.display-5 Welding Tools & Consumables
                                    p.card-text Industrial-grade electrodes, TIG/MIG gear, rods, flux, and safety gear.

                        .col
                            .card.border-0.shadow-sm.h-100
                                img.card-img-top(src="/img/IMG-20250726-WA0027.jpg", alt="Measuring Instruments")
                                .card-body
                                    h6.card-title.mb-1.fs-6.display-5 Flow Meters & Instrumentation
                                    p.card-text Flow control, pressure gauges, temperature sensors, and calibration tools.

                        .col
                            .card.border-0.shadow-sm.h-100
                                img.card-img-top(src="/img/IMG-20250726-WA0028.jpg", alt="Safety Equipment")
                                .card-body
                                    h6.card-title.mb-1.fs-6.display-5 Safety Equipment & PPE
                                    p.card-text Fire-resistant clothing, helmets, gloves, goggles, gas detectors and more.

                        .col
                            .card.border-0.shadow-sm.h-100
                                img.card-img-top(src="/img/IMG-20250726-WA0029.jpg", alt="Electrical and Mechanical Spares")
                                .card-body
                                    h6.card-title.mb-1.fs-6.display-5 Electrical & Mechanical Spares
                                    p.card-text Motors, control panels, junction boxes, lighting, gaskets, seals, and drives.

                        .col
                            .card.border-0.shadow-sm.h-100
                                img.card-img-top(src="/img/IMG-20250726-WA0030.jpg", alt="Lubricants and Coatings")
                                .card-body
                                    h6.card-title.mb-1.fs-6.display-5 Lubricants & Coatings
                                    p.card-text Industrial-grade greases, rust-preventive coatings, sealants, and cleaning agents.

                    .text-gray.mt-5
                        p.fs-6 
                            | We support procurement for greenfield and brownfield projects, shutdowns, and maintenance campaigns — ensuring timely delivery and compliance with local and international standards.





        .animate-from-down.text-gray.mt-5.p-3.bg-light.d-lg-none
            h1.display-5.fs-1 Why Choose Us?
            +chooseUs('Certified Experts', 'Highly skilled and certified pipeline engineers and technicians')
